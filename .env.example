EA_ENV=development
EA_DATABASE_URL=sqlite:///./enterprise-agent.db
EA_CHECKPOINT_URL=sqlite:///./enterprise-agent-checkpoints.sqlite
EA_ARTIFACT_ROOT=./artifacts
EA_OFFLINE_MODE=true
# Set true only when this process may call public web search/fetch in online mode.
EA_ALLOW_EXTERNAL_NETWORK=false
EA_SEARCH_PRIMARY_PROVIDER=tavily
EA_SEARCH_FALLBACK_PROVIDERS=
EA_SEARCH_PROVIDER_TIMEOUT_SECONDS=8
EA_SEARCH_PROVIDER_RETRY_COUNT=1
EA_SEARCH_PROVIDER_RETRY_BACKOFF_SECONDS=0.25
EA_SEARCH_MAX_RESULTS=10
EA_TAVILY_API_KEY_REF=TAVILY_API_KEY
EA_TAVILY_SEARCH_DEPTH=basic
EA_DOUBAO_SEARCH_API_KEY_REF=DOUBAO_SEARCH_API_KEY
EA_DOUBAO_SEARCH_MAX_QUERY_CHARS=500
EA_DOUBAO_SEARCH_QUERY_REWRITE=false
# Cache is fail-closed by default. Use Redis, enable flags, then increase the
# gray percentage gradually in multi-worker production deployments.
EA_RESEARCH_CACHE_BACKEND=memory
# EA_RESEARCH_CACHE_BACKEND=redis
# EA_RESEARCH_CACHE_REDIS_URL=redis://127.0.0.1:6379/0
EA_RESEARCH_CACHE_KEY_VERSION=research-cache-v1
EA_RESEARCH_CACHE_READ_ENABLED=false
EA_RESEARCH_CACHE_WRITE_ENABLED=false
EA_RESEARCH_CACHE_FETCH_ENABLED=false
EA_RESEARCH_CACHE_STALE_IF_ERROR=true
EA_RESEARCH_CACHE_STALE_GRACE_SECONDS=60
EA_RESEARCH_CACHE_SEARCH_TTL_SECONDS=300
EA_RESEARCH_CACHE_FETCH_TTL_SECONDS=900
EA_RESEARCH_CACHE_MAX_ENTRIES=1000
EA_RESEARCH_CACHE_MAX_VALUE_BYTES=1000000
EA_RESEARCH_GRAY_PERCENTAGE=0
EA_RESEARCH_OBSERVABILITY_ENABLED=true
EA_WEB_FETCH_CONNECT_TIMEOUT_SECONDS=5
EA_WEB_FETCH_READ_TIMEOUT_SECONDS=15
EA_WEB_FETCH_WRITE_TIMEOUT_SECONDS=5
EA_WEB_FETCH_POOL_TIMEOUT_SECONDS=5
EA_WEB_FETCH_MAX_BYTES=2000000
EA_WEB_FETCH_MAX_TEXT_CHARS=100000
EA_WEB_FETCH_MAX_REDIRECTS=3
EA_WEB_FETCH_MAX_RETRIES=1
EA_WEB_FETCH_MAX_PDF_PAGES=50
EA_WEB_FETCH_ALLOW_HTTP_DOWNGRADE=false
EA_WEB_FETCH_USER_AGENT=enterprise-agent/0.1
EA_DEV_IDENTITY=true
EA_WORKER_POLL_SECONDS=1
EA_LEASE_SECONDS=30
EA_MAX_REPLANS=2
EA_MAX_TASKS=12
EA_MAX_AGENT_DEPTH=2
EA_MAX_AGENTS=8
EA_MAX_MODEL_CALLS=40
EA_MAX_TOOL_CALLS=80
EA_MAX_STEPS=100
EA_MAX_RUNTIME_SECONDS=300
EA_LOG_LEVEL=INFO
# Leave unset to log only to stderr. Set a path to also write a rotating file.
# EA_LOG_FILE=/var/log/enterprise-agent/app.log
# Only names of environment variables may be placed in model config.
# Secret values below are loaded into the process at startup. A variable
# already set in the environment is left unchanged. Names must match
# credential_ref in configs/models.yaml.
EA_OPENAI_API_KEY_REF=OPENAI_API_KEY
EA_ANTHROPIC_API_KEY_REF=ANTHROPIC_API_KEY
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DASHSCOPE_API_KEY=
ARK_API_KEY=
DEEPSEEK_API_KEY=
TAVILY_API_KEY=
DOUBAO_SEARCH_API_KEY=

