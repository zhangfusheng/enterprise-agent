EA_ENV=development
EA_DATABASE_URL=sqlite:///./enterprise-agent.db
EA_CHECKPOINT_URL=sqlite:///./enterprise-agent-checkpoints.sqlite
EA_ARTIFACT_ROOT=./artifacts
EA_OFFLINE_MODE=true
# Set true only when this process may call public web search/fetch in online mode.
EA_ALLOW_EXTERNAL_NETWORK=false
EA_DEV_IDENTITY=true
EA_WORKER_POLL_SECONDS=1
EA_LEASE_SECONDS=30
EA_MAX_REPLANS=2
EA_MAX_TASKS=12
EA_MAX_AGENT_DEPTH=2
EA_MAX_AGENTS=8
EA_MAX_MODEL_CALLS=40
EA_MAX_TOOL_CALLS=80
EA_MAX_STEPS=100
EA_MAX_RUNTIME_SECONDS=300
EA_LOG_LEVEL=INFO
# Leave unset to log only to stderr. Set a path to also write a rotating file.
# EA_LOG_FILE=/var/log/enterprise-agent/app.log
# Only names of environment variables may be placed in model config.
# Secret values below are loaded into the process at startup. A variable
# already set in the environment is left unchanged. Names must match
# credential_ref in configs/models.yaml.
EA_OPENAI_API_KEY_REF=OPENAI_API_KEY
EA_ANTHROPIC_API_KEY_REF=ANTHROPIC_API_KEY
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DASHSCOPE_API_KEY=
ARK_API_KEY=
DEEPSEEK_API_KEY=

